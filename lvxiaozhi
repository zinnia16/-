        //    所以移动像被弹簧拉着走，绝不是瞬间瞬移的 PPT 效果。
        //    倾斜角根据移动速度实时计算：拎得越快，身子越歪。
        function petLoop() {
            pos.x += (target.x - pos.x) * 0.22;
            pos.y += (target.y - pos.y) * 0.22;

            var vx = target.x - pos.x;
            var tilt = Math.max(-12, Math.min(12, vx * 0.35)); // 限制最大歪 12 度
            petCarry.style.transform = 'rotate(' + tilt + 'deg)';

            // translate3d 走显卡加速通道，比改 left/top 更流畅
            pet.style.transform = 'translate3d(' + pos.x + 'px,' + pos.y + 'px,0)';
            requestAnimationFrame(petLoop);   // 每一帧都继续循环
        }
        requestAnimationFrame(petLoop);

        // 鼠标按下：开始"提起 / 摸摸"手势
        petFace.addEventListener('mousedown', function (e) {
