        var synth = window.speechSynthesis;

        // 2. 找到页面上的下拉框和两个按钮
        var voiceSelect = document.getElementById('voiceSelect');
        var btnThirsty  = document.getElementById('btnThirsty');
        var btnHungry   = document.getElementById('btnHungry');

        // 3. 兼容性判断：极少数老浏览器可能不支持语音合成
        if (!('speechSynthesis' in window)) {
            voiceSelect.innerHTML = '<option>当前浏览器不支持语音合成</option>';
            voiceSelect.disabled = true;
            btnThirsty.disabled = true;
            btnHungry.disabled = true;
        }

        // 4. 把系统里可用的音色，填进下拉框
        function loadVoices() {
            var voices = synth.getVoices(); // 获取系统音色列表（数组）

            // 如果一个音色都没有（浏览器可能还在加载中），直接返回
            if (voices.length === 0) {
                return;
            }

            // 先清空下拉框里的旧内容
            voiceSelect.innerHTML = '';

            for (var i = 0; i < voices.length; i++) {
                var v = voices[i];

                // 创建一个 <option> 并设置显示文字，例如：
                // "Microsoft Xiaoxiao (zh-CN)"
                var option = document.createElement('option');
                option.value = v.name; // value 存音色名字，后面要用它找回音色对象
                option.textContent = v.name + ' (' + v.lang + ')';

                voiceSelect.appendChild(option);
            }

            // 小优化：默认优先选中中文（zh）音色，读中文更自然
            for (var j = 0; j < voices.length; j++) {
                if (voices[j].lang.indexOf('zh') !== -1) {
                    voiceSelect.value = voices[j].name;
                    break;
                }
            }
        }

        // 5. 重要！很多浏览器的音色列表是"异步加载"的：
        //    页面刚打开时 getVoices() 可能返回空数组，
        //    等系统音色加载好后会触发 voiceschanged 事件，这时再填一次。
        loadVoices(); // 先试着加载一次（有的浏览器这里就能拿到）
        if ('onvoiceschanged' in synth) {
            synth.addEventListener('voiceschanged', loadVoices); // 加载好了再填
        }

        // 6. 朗读函数：传入要读的文字
        function speak(text) {

            // speak 会排队朗读，所以先 cancel() 停掉正在读的内容，
            // 这样连续点按钮不会出现"两句话叠在一起说"
            synth.cancel();

            // 创建一个"朗读请求"对象
            var utter = new SpeechSynthesisUtterance(text);

            // 根据下拉框选中的名字，找回对应的音色对象
            var voices = synth.getVoices();
            var selectedName = voiceSelect.value;
            for (var i = 0; i < voices.length; i++) {
                if (voices[i].name === selectedName) {
                    utter.voice = voices[i]; // 应用音色
                    break;
                }
            }

            utter.lang = 'zh-CN'; // 朗读语言：简体中文
            utter.rate = 0.9;     // ★ 语速 0.9（1 为正常语速，小于 1 会更慢更温柔）

            // 让浏览器开始朗读
            synth.speak(utter);
        }

        // 7. 给两个按钮绑定点击事件
        btnThirsty.addEventListener('click', function () {
            speak('主人，我渴了');
        });

        btnHungry.addEventListener('click', function () {
            speak('主人，我饿了');
        });


        /* ============================================================
           功能三：养护诊断（点按钮 → 查表 → 显示建议）
           这里用"对象字面量"当一张小字典：
             key（键）   = 下拉框 option 的 value
             value（值） = 对应的诊断建议文字
           ============================================================ */

        // 1. 症状与建议的对照表（以后想加新症状，直接在这里加一行就行）
        var diagnosisMap = {
            yellow: '诊断：叶子发黄，多半是浇水过多或缺少光照。<br>建议：先检查盆土是否积水，把绿植移到散射光充足的地方，黄叶及时剪掉，一周左右观察新叶情况。',
            dry:   '诊断：叶尖干枯发脆，通常是空气太干燥或缺水。<br>建议：用喷壶给叶片周围喷雾增湿，浇水要"浇则浇透"，同时远离空调出风口和暖气片。',
            drop:  '诊断：大量掉叶子，可能是温度骤变、通风不良或刚换环境。<br>建议：把绿植放在温度稳定、通风的位置，短期内不要施肥，让它慢慢缓苗适应。',
            smell: '诊断：盆土有异味，很可能是浇水太多导致烂根！<br>建议：立刻停止浇水，把绿植脱盆检查根系，剪掉发黑发软的烂根，换上疏松透气的新土重新栽种。',
            bug:   '诊断：叶片上有小虫，常见的是蚜虫或红蜘蛛。<br>建议：先用清水冲洗叶片正反面，虫害严重时使用低毒杀虫剂，并与其他绿植隔离开防止传染。'
        };

        // 2. 找到相关元素
        var symptomSelect   = document.getElementById('symptomSelect');
        var btnDiagnose     = document.getElementById('btnDiagnose');
        var diagnosisResult = document.getElementById('diagnosisResult');

        // 3. 绑定"开始诊断"按钮的点击事件
        btnDiagnose.addEventListener('click', function () {

            // 拿到当前选中的症状值，例如 "yellow"
            var key = symptomSelect.value;

            // 如果用户还没选症状，弹窗提醒
            if (key === '') {
                alert('请先选择一个症状哦～');
                return; // return：让函数到此结束，后面代码不再执行
            }

            // 用 key 去字典里查建议，显示到结果框里
            diagnosisResult.innerHTML = diagnosisMap[key];
            diagnosisResult.style.display = 'block'; // 显示结果框
        });


        /* ============================================================
           功能四：定时自动语音播报
           效果：每隔一段时间，随机朗读"主人，我渴了"或"主人，我饿了"
           亮点：
             1. 页面加载后自动开始播报
             2. 间隔时间可以在输入框里自己设置（单位：秒）
             3. 有开关按钮，可以随时开启 / 关闭
           ============================================================ */

        // 1. 找到相关元素
        var intervalInput   = document.getElementById('intervalInput');   // 间隔输入框
        var btnBroadcast    = document.getElementById('btnBroadcast');    // 开关按钮
        var broadcastStatus = document.getElementById('broadcastStatus'); // 状态提示

        // 2. 播报内容（一个数组，存两句话，每次随机挑一句）
        var broadcastTexts = ['主人，我渴了', '主人，我饿了'];

        // 3. 两个"开关"变量
        var isBroadcasting = false;  // 是否正在定时播报（true = 开，false = 关）
        var broadcastTimer = null;   // setTimeout 的返回值，用来取消还没到点的播报

        // 4. 小工具函数：读取用户设置的间隔秒数，并做"保护"
        //    用户可能输入 0、负数或乱填，这里统一兜底到合法范围
        function getIntervalSeconds() {
            var sec = parseInt(intervalInput.value, 10); // 把输入框内容转成整数
            if (isNaN(sec)) { sec = 30; }     // 完全不是数字 → 默认 30 秒
            if (sec < 5)    { sec = 5; }      // 最小 5 秒，避免播报太频繁
            if (sec > 3600) { sec = 3600; }   // 最大 1 小时
            return sec;
        }

        // 5. 排好"下一次"播报（用 setTimeout 递归调用自己，形成循环）
        //    为什么不用 setInterval？因为用户可能中途改间隔，
        //    用 setTimeout 每次重新读取间隔，改完下一次就生效，更灵活。
        function scheduleNextBroadcast() {
            // 如果播报已关闭，就不再排下一次（递归的"出口"，防止停不下来）
            if (!isBroadcasting) {
                return;
            }

            // setTimeout(要做的事, 等待的毫秒数)
            broadcastTimer = setTimeout(function () {

                // 随机挑一句话：
                // Math.random() 生成 0~1 的小数，乘以 2 后向下取整 = 0 或 1
                var index = Math.floor(Math.random() * broadcastTexts.length);

                // 调用功能二写好的 speak()，语速同样是 0.9
                speak(broadcastTexts[index]);

                // 这次读完，再排下一次 —— 于是形成"无限循环播报"
                scheduleNextBroadcast();

            }, getIntervalSeconds() * 1000); // 秒 → 毫秒（×1000）
        }

        // 6. 开启播报
        function startBroadcast() {
            isBroadcasting = true;
            btnBroadcast.textContent = '⏸ 关闭播报'; // 按钮文字变成"关闭"
            broadcastStatus.textContent = '🟢 定时播报已开启，每 ' + getIntervalSeconds() + ' 秒随机说一句';
            scheduleNextBroadcast(); // 排第一次播报
        }

        // 7. 关闭播报
        function stopBroadcast() {
            isBroadcasting = false;

            // clearTimeout 取消还没到点的那次播报（很关键！）
            if (broadcastTimer !== null) {
                clearTimeout(broadcastTimer);
                broadcastTimer = null;
            }

            btnBroadcast.textContent = '▶ 开启播报'; // 按钮文字变成"开启"
            broadcastStatus.textContent = '🔴 定时播报已关闭';
        }

        // 8. 开关按钮：点一下切换 开 / 关
        btnBroadcast.addEventListener('click', function () {
            if (isBroadcasting) {
                stopBroadcast();
            } else {
                startBroadcast();
            }
        });

        // 9. 用户修改间隔后：如果正在播报，就按新间隔重新排一次，
        //    这样不用关掉再开就能生效
        intervalInput.addEventListener('change', function () {
            if (isBroadcasting) {
                if (broadcastTimer !== null) {
                    clearTimeout(broadcastTimer);
                }
                broadcastStatus.textContent = '🟢 定时播报已开启，每 ' + getIntervalSeconds() + ' 秒随机说一句';
                scheduleNextBroadcast();
            }
        });

        // 10. ★ 页面加载后自动启动定时播报
        //     注意：多数浏览器有"自动播放声音"限制，
        //     刚打开页面就说话可能被浏览器拦住。
        //     解决小技巧：监听用户"第一次点击页面"，点过之后声音就正常了。
        startBroadcast();

        // 用户第一次点击页面时，重新启动一次播报（相当于"解锁"浏览器声音）
        document.addEventListener('click', function unlockVoice() {
            if (isBroadcasting) {
                // cancel 后重新 speak 一次空操作不可行，
                // 简单做法：直接把下一次播报提前到现在（立即说一句）
                var index = Math.floor(Math.random() * broadcastTexts.length);
                speak(broadcastTexts[index]);
            }
            // removeEventListener：解锁只需要一次，之后不用再监听
            document.removeEventListener('click', unlockVoice);
        });


        /* ============================================================
           功能五：挂件模式
           效果：点"挂件模式"按钮后，
             · 隐藏导航栏、绿植卡片、传感器台账等全部其他内容
             · 只保留虚拟形象
             · 页面背景变透明（适合做桌面挂件）
           原理：往 <body> 上添加 / 删除 widget-mode 类名，
                 具体"隐藏谁、透明谁"全交给 CSS（见样式第 10 部分），
                 JS 只负责切换类名 —— 这叫"行为与样式分离"。
           ============================================================ */

        // 1. 找到两个按钮
        var btnWidget      = document.getElementById('btnWidget');      // 导航栏里的"挂件模式"
        var btnWidgetExit  = document.getElementById('btnWidgetExit');  // 右上角的"退出挂件模式"

        // 2. 点"挂件模式"：给 body 和 html 加上 widget-mode 类
        btnWidget.addEventListener('click', function () {
            document.body.classList.add('widget-mode');
            document.documentElement.classList.add('widget-mode'); // html 也加，背景才能透明

            // 桌宠视角：舞台突然变大了，把人物挪回中间并打个招呼
            setTimeout(function () {
                resetPetPosition();
                say('挂件模式启动！拖着我到处走吧～', 3000);
            }, 60);
        });

        // 3. 点"退出挂件模式"：把类删掉，页面恢复原样
        btnWidgetExit.addEventListener('click', function () {
            document.body.classList.remove('widget-mode');
            document.documentElement.classList.remove('widget-mode');

            // 回到普通网页：让坐着的桌宠站起来、回到卡片里
            setTimeout(function () {
                standUp();
                resetPetPosition();
                say('回来啦～', 2000);
            }, 60);
        });


        /* ============================================================
           功能六：麦克风语音输入互动
           说明：
             SpeechRecognition 是浏览器内置的"语音识别器"，
             你对着麦克风说话，它会自动转成文字（zh-CN 中文）。
             桌宠收到文字后，只用【动作 + 对话框文字】回应，
             不再朗读出来 —— 像真正的桌宠一样"看"你说话。
           注意：
             · Chrome / Edge 支持最好（需要 https 或 localhost 或 file 一般也行）
             · 第一次点按钮，浏览器会弹窗询问麦克风权限，要选"允许"
             · 说完一句话后识别会自动停下来，想继续聊就再点一次按钮
           ============================================================ */

        // 1. 浏览器兼容：Chrome 内核叫 webkitSpeechRecognition
        var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        var recognition = null;   // 识别器对象（后面创建）
        var isRecognizing = false;

        // 2. 语音回复规则表：把"听到的关键词"映射到"桌宠反应"
        //    规则：从上往下找，谁先匹配到就执行谁（所以更具体的词放上面）
        var voiceRules = [
            { keys: ['浇水', '喷水'],      act: 'care',    reply: '好嘞！我提醒主人：绿萝土干 2cm 再浇，浇则浇透哦～' },
            { keys: ['渴', '口渴'],        act: 'thirsty', reply: '主人，我渴啦！' },
            { keys: ['饿', '肚子饿'],      act: 'hungry',  reply: '主人，我饿啦！' },
            { keys: ['爱你', '喜欢你'],    act: 'love',    reply: '主人，我好爱你啊！' },
            { keys: ['抱'],               act: 'hug',     reply: '主人，抱抱嘛！' },
            { keys: ['摸'],               act: 'pet',     reply: '好舒服～还要摸摸！' },
            { keys: ['你好', '您好', '嗨', '哈喽'], act: 'wave',  reply: '你好呀！见到你真开心～' },
            { keys: ['笑'],               act: 'joke',    reply: '' },   // 空字符串 = 用台词库里的笑话
            { keys: ['魔法', '变'],        act: 'magic',   reply: '✨看我的小魔法！绿植快快长！' },
            { keys: ['跳'],               act: 'jump',    reply: '看我跳得高不高！' },
            { keys: ['转', '跳舞'],        act: 'dance',   reply: '转个圈圈～' },
            { keys: ['喝', '咖啡'],        act: 'coffee',  reply: '主人，来杯咖啡吗？☕' },
            { keys: ['植物', '绿植', '花', '绿萝', '多肉', '吊兰'], act: 'care', reply: '' },
            { keys: ['名字', '叫什么'],    act: 'wave',    reply: '我叫绿小植，是你的绿植小管家哦！' },
            { keys: ['再见', '拜拜', '晚安'], act: 'wave',  reply: '主人再见～我会想你的！' }
        ];

        // 3. 创建识别器并配置（如果浏览器支持的话）
        if (SpeechRecognition) {
            recognition = new SpeechRecognition();
            recognition.lang = 'zh-CN';            // 识别中文
            recognition.continuous = false;        // 说一句就自动停（省电、不打扰）
            recognition.interimResults = false;    // 只要最终结果，不要半成品

            // 识别成功：拿到文字，交给"关键词匹配"处理
            recognition.onresult = function (event) {
                var text = event.results[0][0].transcript;
                handleVoiceText(text);
            };

            // 识别结束（不管成功失败）：恢复按钮样子
            recognition.onend = function () {
                isRecognizing = false;
                micBtn.classList.remove('is-listening');
                micBtn.textContent = '🎤 和我说话';
            };

            // 识别出错：没听清 / 没给权限，友好提示
            recognition.onerror = function () {
                say('唔…没听清，再说一次好不好？');
            };
        }

        // 4. 点麦克风按钮：开始 / 停止识别
        micBtn.addEventListener('click', function () {
            if (!recognition) {
                say('这个浏览器不支持语音识别，换个 Chrome 或 Edge 试试～', 3500);
                return;
            }

            if (isRecognizing) {
                recognition.stop();   // 正在听 → 点一下停
                return;
            }

            isRecognizing = true;
            micBtn.classList.add('is-listening');   // 按钮发光 + 跳动
            micBtn.textContent = '🔴 正在听…（点我停下）';
            say('嗯嗯，我在听～主人请讲！', 2800);
            recognition.start();
        });

        // 5. 拿到你说的文字后：找关键词 → 做动作 + 气泡回复
        function handleVoiceText(text) {
            // 先在气泡里"回显"你说的话，证明它真的听见了
            say('「' + text + '」', 2000);

            // 0.9 秒后桌宠再做出回应（节奏感：先看再说，像在思考）
            setTimeout(function () {
                respondToVoice(text);
            }, 900);
        }

        function respondToVoice(text) {
            // 逐条规则找关键词
            for (var i = 0; i < voiceRules.length; i++) {
                var rule = voiceRules[i];
                for (var j = 0; j < rule.keys.length; j++) {
                    if (text.indexOf(rule.keys[j]) !== -1) {
                        doVoiceAction(rule.act, rule.reply);
                        return;   // 匹配到一条就够了
                    }
                }
            }

            // 什么都没匹配到：歪头 + 可爱的万能回复
            doTiltHead();
            setTimeout(function () {
                say('唔…这个我还听不太懂，不过主人说什么都好听！', 3200);
            }, 700);
        }

        // 6. 动作分发器：一个函数统一管理"语音 → 动作"的对应关系
        function doVoiceAction(act, reply) {
            // 先做动作（动作本身就是回应的一部分）
            if (act === 'wave')         doWave();
            else if (act === 'love')  { spawnHearts(5); setFace('smile'); playAnim(petWiggle, 'anim-wiggle'); }
            else if (act === 'hug')   { playAnim(petSquash, 'anim-squash'); spawnHearts(3); setFace('smile'); }
            else if (act === 'pet')     doPetted();
            else if (act === 'thirsty') { playAnim(petWiggle, 'anim-wiggle'); setFace('blink'); }
            else if (act === 'hungry')  { playAnim(petSquash, 'anim-squash'); }
            else if (act === 'care')    doTiltHead();
            else if (act === 'joke')    doMagic();
            else if (act === 'magic')   doMagic();
            else if (act === 'jump')    doJump();
            else if (act === 'dance')   doWave();
            else if (act === 'coffee')  doCoffee();

            // 再用气泡说话（reply 为空 → 从台词库随机挑）
            setTimeout(function () {
                if (reply && reply.length > 0) {
                    say(reply, 3400);
                } else if (act === 'joke') {
                    // 给"讲笑话"准备的植物冷笑话（想加就往数组里补）
                    var jokes = [
                        '为什么绿萝从来不迷路？因为它总能找到"光"的方向！',
                        '多肉为什么这么胖？因为它把水都喝到肚子里存着啦！',
                        '吊兰说：我虽然叫"吊"兰，但我从来不迟到！',
                        '植物开会，谁没来？含羞草 —— 它害羞请假了！'
                    ];
                    say(pick(jokes), 4200);
                } else {
                    say(pick(petPhrases.care), 3400);
                }
            }, 650);
        }

    </script>

