        /* ---------- 1-5 鼠标交互：提起 · 摸摸 · 坐下 · 点按 ---------- */

        // 把人物位置限制在舞台范围内，防止拖出界再也找不回来
        function clampToStage(x, y) {
            var w  = pet.offsetWidth,  h  = pet.offsetHeight;
            var sw = petStage.clientWidth, sh = petStage.clientHeight;
            return {
                x: Math.max(0, Math.min(sw - w, x)),
                y: Math.max(-20, Math.min(sh - h + 30, y))
            };
        }

        // 人物初始位置：舞台水平居中
        function resetPetPosition() {
            var p = clampToStage((petStage.clientWidth - pet.offsetWidth) / 2, 40);
            target.x = p.x; target.y = p.y;
            pos.x    = p.x; pos.y    = p.y;
        }
