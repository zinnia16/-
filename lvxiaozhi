<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <!--
        ============================================================
        家庭绿植养护 Agent 首页
        技术：HTML + CSS + 原生 JavaScript（无后端、无数据库、无框架）
        作者注释风格：面向大一同学，每一步都解释"为什么这么写"
        ============================================================

        【图片文件说明】
        请把下面 3 张图片放在和本文件（index.html）同一个文件夹里：
          open.png   —— 虚拟形象"睁眼"的样子（默认显示）
          blink.png  —— 虚拟形象"眨眼/闭眼"的样子（鼠标移入时先切换）
          smile.png  —— 虚拟形象"微笑"的样子（移入 0.3 秒后切换）
    -->

    <!-- 声明文档类型和字符编码，保证中文不乱码 -->
    <meta charset="UTF-8">
    <!-- viewport：让页面在手机上也能正常自适应显示 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>绿小植 · 家庭绿植养护 Agent</title>

    <style>
        /* ============================================================
           第 1 部分：CSS 变量（统一管理颜色，改一处全站生效）
           ============================================================ */
        :root {
            --green-dark:   #2f6b4f;   /* 深绿：标题、导航 */
            --green-main:   #4caf7d;   /* 主绿：按钮、高亮 */
            --green-light:  #e8f5ee;   /* 浅绿：区块背景 */
            --bg:           #f6faf5;   /* 页面底色（淡淡的绿白） */
            --card-bg:      #ffffff;   /* 卡片底色 */
            --text:         #2d3a2e;   /* 正文文字颜色 */
            --text-gray:    #6b7a6e;   /* 次要文字（灰色） */
            --shadow:       0 6px 20px rgba(47, 107, 79, 0.12); /* 普通阴影 */
            --shadow-hover: 0 16px 32px rgba(47, 107, 79, 0.20);/* 悬浮时更深的阴影 */
            --radius:       16px;      /* 圆角大小 */
        }

        /* ============================================================
           第 2 部分：基础样式（清除浏览器默认边距）
           ============================================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box; /* 让 width 包含 padding 和 border，计算尺寸更直观 */
        }

        html {
            scroll-behavior: smooth; /* 点击导航锚点时，页面平滑滚动（不加这行会瞬间跳转） */
        }

        body {
            font-family: "Microsoft YaHei", "PingFang SC", sans-serif; /* 中文友好字体 */
            background-color: var(--bg);
            color: var(--text);
            line-height: 1.7; /* 行高大一点，读起来舒服 */
        }

        /* 统一给每个大区块设置"锚点偏移"：
           因为导航栏是固定在顶部的，直接跳转会把标题盖住，
           scroll-margin-top 让跳转目标往下留出导航栏的高度 */
        section {
            scroll-margin-top: 90px;
        }

        /* ============================================================
           第 3 部分：导航栏
           ============================================================ */
        .navbar {
            position: fixed;      /* 固定在浏览器窗口顶部 */
            top: 0;
            left: 0;
            right: 0;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 6%;
            background: rgba(255, 255, 255, 0.92); /* 半透明白色 */
            backdrop-filter: blur(10px);            /* 毛玻璃效果 */
            box-shadow: 0 2px 12px rgba(47, 107, 79, 0.08);
            z-index: 1000; /* 保证导航栏永远盖在其他内容上面 */
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
            color: var(--green-dark);
            letter-spacing: 1px;
        }

        .nav-links {
            display: flex;
            gap: 8px;
            list-style: none;
        }

        .nav-links a {
            display: inline-block;
            padding: 8px 16px;
            border-radius: 999px;               /* 胶囊形圆角 */
            color: var(--text);
            text-decoration: none;              /* 去掉链接下划线 */
            font-size: 15px;
            transition: background-color 0.25s, color 0.25s; /* 过渡动画写在 a 上 */
        }

        .nav-links a:hover {
            background-color: var(--green-main);
            color: #fff;
        }

        /* ============================================================
           第 4 部分：首页 Hero 区（左边文字 + 右边虚拟形象）
           ============================================================ */
        .hero {
            max-width: 1100px;
            margin: 0 auto;
            padding: 130px 6% 60px; /* 顶部留出导航栏的高度，不然内容会被挡住 */
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
            flex-wrap: wrap; /* 窄屏时自动换行，左边文字换到上面 */
        }

        .hero-text {
            flex: 1;
            min-width: 300px;
        }

        .hero-text h1 {
            font-size: 40px;
            color: var(--green-dark);
            margin-bottom: 16px;
            line-height: 1.3;
        }

        .hero-text .slogan {
            font-size: 18px;
            color: var(--text-gray);
            margin-bottom: 30px;
        }

        /* ---------- 语音模块 ---------- */
        .voice-panel {
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 22px 24px;
            box-shadow: var(--shadow);
            max-width: 460px;
        }

        .voice-panel h2 {
            font-size: 18px;
            color: var(--green-dark);
            margin-bottom: 14px;
        }

        /* 下拉框样式 */
        .voice-panel select {
            width: 100%;
            padding: 10px 12px;
            font-size: 15px;
            border: 2px solid var(--green-light);
            border-radius: 10px;
            background: #fff;
            color: var(--text);
            outline: none;                /* 去掉默认的蓝色聚焦框 */
            cursor: pointer;
            margin-bottom: 14px;
            transition: border-color 0.25s;
        }

        .voice-panel select:focus {
            border-color: var(--green-main); /* 获得焦点时边框变绿 */
        }

        .voice-btns {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .voice-btns button {
            flex: 1;
            min-width: 150px;
            padding: 12px 10px;
            font-size: 15px;
            font-weight: bold;
            color: #fff;
            background: var(--green-main);
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: transform 0.2s, background-color 0.2s, box-shadow 0.2s;
        }

        .voice-btns button:hover {
            background: var(--green-dark);
            transform: translateY(-2px);      /* 按钮轻微上浮 */
            box-shadow: var(--shadow);
        }

        .voice-btns button:active {
            transform: translateY(0);          /* 按下时回到原位，产生"按压感" */
        }

        /* ---------- 定时自动播报控制条 ---------- */
        .broadcast-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 16px;
            font-size: 14px;
            color: var(--text-gray);
        }

        .broadcast-row label {
            white-space: nowrap; /* 文字不要换行，"播报间隔（秒）"保持一行 */
        }

        /* 间隔时间输入框（只能填数字） */
        .broadcast-row input {
            width: 90px;
            padding: 8px 10px;
            font-size: 15px;
            text-align: center;
            border: 2px solid var(--green-light);
            border-radius: 10px;
            outline: none;
        }

        .broadcast-row input:focus {
            border-color: var(--green-main);
        }

        /* 开启 / 关闭播报的开关按钮 */
        .broadcast-toggle {
            flex: 1;
            padding: 10px;
            font-size: 15px;
            font-weight: bold;
            color: #fff;
            background: var(--green-dark);
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: background-color 0.25s, transform 0.2s;
        }

        .broadcast-toggle:hover {
            background: var(--green-main);
            transform: translateY(-2px);
        }

        /* 播报状态提示文字 */
        .broadcast-status {
            margin-top: 10px;
            font-size: 13px;
            color: var(--text-gray);
        }

        /* ---------- 可互动桌宠（VRM 风格虚拟形象） ---------- */
        /*
           ★★★ 为什么动作能"丝滑连贯"而不卡？—— 分层动画大法 ★★★
           人物外面套了 7 层 <div>，每层"只管一种运动"：
             #pet        → 跟着鼠标走（位置移动）
             .pet-carry  → 被提起来时的左右倾斜（用移动速度实时算角度）
             .pet-pose   → 姿态：歪头看人、坐下前倾（类名 + transition 切换）
             .pet-squash → 弹性：跳起 / 落地的压扁拉伸（一次性动画）
             .pet-sway   → 坐下时晃小腿（循环动画）
             .pet-float  → 平时悬浮呼吸（循环动画，一直在动）
             .pet-wiggle → 被摸、打招呼的摇摆（一次性动画）
           每层只写自己的 transform，互不覆盖、自动叠加，
           所以动作之间是平滑过渡，绝不是一帧一帧切换图片的 PPT 效果。
        */
        .hero-avatar {
            text-align: center;
        }

        /* 舞台：桌宠活动的范围（普通模式下就是右侧头像区域） */
        .pet-stage {
            position: relative;               /* 给内部的 .pet 当定位基准 */
            width: 320px;
            height: 400px;
            margin: 0 auto;
        }

        /* 第 1 层：桌宠本体 —— 只负责"位置"，用 JS 设置 translate3d */
        .pet {
            position: absolute;
            left: 0;
            top: 0;
            width: 220px;
            height: 260px;
            /* 用 translate3d 走"显卡加速通道"，比改 left/top 更流畅 */
            will-change: transform;
        }

        /* 第 2 层：被提起来时的倾斜（JS 实时写 rotate） */
        .pet-carry {
            width: 100%;
            height: 100%;
            will-change: transform;
        }

        /* 第 3 层：姿态（歪头 / 坐下）—— 用类名切换 + 过渡动画 */
        .pet-pose {
            width: 100%;
            height: 100%;
            transition: transform 0.5s cubic-bezier(0.34, 1.3, 0.64, 1); /* 带一点回弹感 */
        }

        /* 姿态：歪头看屏幕外的你（图二效果） */
        .pet-pose.is-tilt {
            transform: rotate(-9deg);
        }

        /* 姿态：坐在边沿时微微前倾（图五效果） */
        .pet-pose.is-sitting {
            transform: rotate(-2deg) translateY(4px);
        }

        /* 姿态：施展魔法时缓缓升空（图八效果）
           —— 与上面共用同一条 0.5s 过渡曲线，升起 / 落下都很顺滑 */
        .pet-pose.is-magic-levitate {
            transform: translateY(-22px) scale(1.04);
        }

        /* 第 4 层：弹性压扁拉伸（跳起 / 落地 / 伸懒腰） */
        .pet-squash {
            width: 100%;
            height: 100%;
        }

        /* 第 5 层：坐下时晃小腿（只有 .is-sitting 时才启动循环动画） */
        .pet-sway {
            width: 100%;
            height: 100%;
        }

        .pet-sway.is-sitting {
            animation: petSway 2.2s ease-in-out infinite; /* 来回晃 */
        }

        /* 第 6 层：平时的悬浮呼吸（一直都在动，人物才"活着"） */
        .pet-float {
            width: 100%;
            height: 100%;
            animation: petFloat 3.2s ease-in-out infinite;
        }

        /* 第 7 层：摇摆（被摸头、打招呼时的一次性动画） */
        .pet-wiggle {
            width: 100%;
            height: 100%;
        }

        /* ---------- 关键帧动画 ---------- */
        @keyframes petFloat {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-9px); }  /* 轻轻飘起来 */
        }

        @keyframes petSway {
            0%, 100% { transform: rotate(-2.5deg); }   /* 像坐在桌沿晃腿 */
            50%      { transform: rotate(2.5deg); }
        }

        @keyframes petWiggle {
            0%, 100% { transform: rotate(0deg); }
            25%      { transform: rotate(-7deg); }
            50%      { transform: rotate(7deg); }
            75%      { transform: rotate(-4deg); }
        }

        @keyframes petSquash {
            0%   { transform: scale(1, 1); }
            35%  { transform: scale(1.12, 0.88); }     /* 落地压扁 */
            65%  { transform: scale(0.92, 1.1); }      /* 弹起拉伸 */
            100% { transform: scale(1, 1); }
        }

        @keyframes petJump {
            0%   { transform: translateY(0) scale(1, 1); }
            30%  { transform: translateY(-34px) scale(0.94, 1.08); } /* 起跳 */
            55%  { transform: translateY(-38px) scale(1, 1); }
            85%  { transform: translateY(0) scale(1.1, 0.9); }      /* 落地压一下 */
            100% { transform: translateY(0) scale(1, 1); }
        }

        /* ---------- 人物"立牌"（亚克力立牌风格，参考图七） ---------- */
        .pet-face {
            position: relative;
            width: 100%;
            height: 100%;
            border-radius: 28px;
            overflow: hidden;
            background: linear-gradient(160deg, #eef7f2, #dcefe6);
            border: 3px solid rgba(255, 255, 255, 0.9);
            box-shadow: var(--shadow-hover);
            cursor: grab;                     /* 抓手光标：提示"可以抓起来" */
            user-select: none;                /* 拖动时不要选中文字 */
        }

        .pet.is-dragging .pet-face {
            cursor: grabbing;
            box-shadow: 0 22px 44px rgba(47, 107, 79, 0.28); /* 提起来阴影变大 */
        }

        /* 四张表情图叠在一起，用透明度"淡入淡出"切换 —— 比换 src 更顺滑 */
        .pet-face img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0;                       /* 默认全透明 */
            transition: opacity 0.22s ease;   /* 切换表情 = 平滑淡变 */
            pointer-events: none;             /* 图片不挡鼠标事件，拖拽才正常 */
            -webkit-user-drag: none;
        }

        .pet-face img.show {
            opacity: 1;                       /* 加上 show 类的那张显示出来 */
        }

        /* 魔法立绘（图八）：大动作换装用更长的淡变，衔接才不突兀；
           object-position 微调让"人物 + 光环"正好落在立牌中央 */
        .pet-face img#faceMagic {
            object-position: center 40%;
            transition: opacity 0.45s ease;
        }

        /* 魔法特效：施法时立牌持续柔光呼吸（JS 播完会移除类名停掉） */
        .pet-face.is-magic {
            animation: petMagic 1.1s ease-in-out infinite;
        }

        @keyframes petMagic {
            0%, 100% { box-shadow: var(--shadow-hover); }
            50%      { box-shadow: 0 0 42px rgba(120, 220, 170, 0.85); }
        }

        /* ---------- 一次性动作（JS 加类名触发，播完自动移除） ----------
           用法：元素.classList.add('anim-wiggle') 播放一次，
                 动画结束后 JS 再 remove 掉，下次才能重复播放 */
        .anim-wiggle { animation: petWiggle 0.65s ease-in-out; }
        .anim-shake  { animation: petWiggle 0.45s ease-in-out; } /* 快速摇头 */
        .anim-squash { animation: petSquash 0.55s ease-in-out; } /* 落地弹性 */
        .anim-jump   { animation: petJump 0.8s ease-in-out; }    /* 跳一下 */

        /* ---------- 白色对话框（图一效果） ---------- */
        .pet-bubble {
            position: absolute;
            left: 50%;
            bottom: calc(100% + 12px);        /* 出现在头顶上方 */
            transform: translateX(-50%) scale(0.75);
            transform-origin: bottom center;
            max-width: 230px;
            padding: 12px 18px;
            background: #ffffff;
            color: #3a3a3a;
            font-size: 15px;
            font-weight: bold;
            line-height: 1.5;
            text-align: center;
            border: 2px solid #e2e2e2;        /* 参考图：白底 + 浅灰描边 */
            border-radius: 18px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.10);
            opacity: 0;
            transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            pointer-events: none;             /* 气泡不挡鼠标 */
            z-index: 5;
        }

        .pet-bubble.show {
            opacity: 1;
            transform: translateX(-50%) scale(1); /* 弹出来 */
        }

        /* 对话框下面的小三角尾巴 */
        .pet-bubble::after {
            content: '';
            position: absolute;
            left: 50%;
            bottom: -9px;
            transform: translateX(-50%);
            border: 9px solid transparent;
            border-top-color: #ffffff;
            border-bottom: none;
        }

        /* ---------- 特效粒子层（爱心 / 星星） ---------- */
        .pet-particles {
            position: absolute;
            inset: 0;
            overflow: visible;
            pointer-events: none;
            z-index: 6;
        }

        /* 爱心：从人物身上飘起来 */
        .fx-heart {
            position: absolute;
            font-size: 22px;
            animation: fxFly 1.5s ease-out forwards; /* forwards = 结束后停在终点 */
        }

        @keyframes fxFly {
            0%   { opacity: 0; transform: translateY(6px) scale(0.4); }
            25%  { opacity: 1; }
            100% { opacity: 0; transform: translateY(-95px) scale(1.2) rotate(12deg); }
        }

        /* 星星：魔法施放时向四周飞散（--dx / --dy 是自定义变量，JS 生成时随机填） */
        .fx-spark {
            position: absolute;
            font-size: 20px;
            animation: fxSpark 1.1s ease-out forwards;
        }

        @keyframes fxSpark {
            0%   { opacity: 0; transform: translate(0, 0) scale(0.3) rotate(0deg); }
            20%  { opacity: 1; }
            100% { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(1.1) rotate(160deg); }
        }

        /* ---------- 语音输入按钮 ---------- */
        .mic-btn {
            margin-top: 16px;
            padding: 11px 26px;
            font-size: 15px;
            font-weight: bold;
            color: #fff;
            background: var(--green-main);
            border: none;
            border-radius: 999px;
            cursor: pointer;
            box-shadow: var(--shadow);
            transition: background-color 0.25s, transform 0.2s;
        }

        .mic-btn:hover {
            background: var(--green-dark);
            transform: translateY(-2px);
        }

        /* 正在听你说话时：按钮轻轻"呼吸"发光 */
        .mic-btn.is-listening {
            background: #e2574c;
            animation: micPulse 1s ease-in-out infinite;
        }

        @keyframes micPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(226, 87, 76, 0.5); }
            50%      { box-shadow: 0 0 0 12px rgba(226, 87, 76, 0); }
        }

        .pet-hint {
            margin-top: 12px;
            font-size: 14px;
            color: var(--text-gray);
        }

        /* ============================================================
           第 5 部分：通用区块样式（标题 + 内容容器）
           ============================================================ */
        .section-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 60px 6%;
        }

        .section-title {
            text-align: center;
            font-size: 30px;
            color: var(--green-dark);
            margin-bottom: 8px;
        }

        .section-subtitle {
            text-align: center;
            color: var(--text-gray);
            margin-bottom: 36px;
            font-size: 15px;
        }

        .bg-green  { background: var(--green-light); } /* 浅绿背景区块 */
        .bg-white  { background: #fff; }

        /* ============================================================
           第 6 部分：传感器台账（表格）
           ============================================================ */
        .table-wrap {
            overflow-x: auto; /* 表格太宽时出现横向滚动条，不会把页面撑坏 */
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            background: var(--card-bg);
        }

        table {
            width: 100%;
            border-collapse: collapse; /* 合并相邻单元格的边框 */
            min-width: 640px;
        }

        thead th {
            background: var(--green-dark);
            color: #fff;
            padding: 14px 16px;
            font-size: 15px;
            text-align: left;
        }

        tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--green-light);
            font-size: 15px;
        }

        tbody tr:hover {
            background-color: var(--green-light); /* 鼠标悬浮整行变浅绿 */
        }

        /* 状态徽章（小圆角标签） */
        .badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: bold;
        }

        .badge-ok   { background: #e3f6ea; color: #2e9e5b; } /* 正常 */
        .badge-high { background: #fff3e0; color: #e08a2e; } /* 偏高 */
        .badge-low  { background: #fde7e7; color: #d9534f; } /* 偏低 */

        /* ============================================================
           第 7 部分：养护诊断（下拉选症状 + 一键诊断）
           ============================================================ */
        .diagnosis-box {
            max-width: 640px;
            margin: 0 auto;
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 28px;
            box-shadow: var(--shadow);
        }

        .diagnosis-box select {
            width: 100%;
            padding: 11px 12px;
            font-size: 15px;
            border: 2px solid var(--green-light);
            border-radius: 10px;
            outline: none;
            cursor: pointer;
            margin-bottom: 14px;
            background: #fff;
        }

        .diagnosis-box select:focus {
            border-color: var(--green-main);
        }

        .diagnosis-box button {
            width: 100%;
            padding: 12px;
            font-size: 16px;
            font-weight: bold;
            color: #fff;
            background: var(--green-main);
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: background-color 0.25s, transform 0.2s;
        }

        .diagnosis-box button:hover {
            background: var(--green-dark);
            transform: translateY(-2px);
        }

        /* 诊断结果显示区域（默认先藏起来） */
        .diagnosis-result {
            margin-top: 18px;
            padding: 16px 18px;
            background: var(--green-light);
            border-left: 5px solid var(--green-main); /* 左侧一条绿色竖线做装饰 */
            border-radius: 8px;
            font-size: 15px;
            display: none; /* 一开始不显示，点按钮后用 JS 显示 */
        }

        /* ============================================================
           第 8 部分：绿植卡片列表（重点：悬浮上浮效果）
           ============================================================ */
        .plant-grid {
            display: grid;
            /* repeat(auto-fit, minmax(250px, 1fr))
               = 自动换列：每张卡最少 250px 宽，尽量平分剩余空间
               这样不用写媒体查询也能自适应手机 / 平板 / 电脑 */
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 24px;
        }

        .plant-card {
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 24px;
            box-shadow: var(--shadow);

            /* ---- 悬浮上浮的核心：transition ----
               transform 负责"移动"，box-shadow 负责"阴影加深"，
               两个都写进 transition，鼠标进出就会有平滑动画（0.3 秒） */
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        /* 鼠标悬浮在卡片上时：向上移动 8px + 阴影变大 */
        .plant-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-hover);
        }

        .plant-emoji {
            width: 72px;
            height: 72px;
            border-radius: 20px;
            background: var(--green-light);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 38px;
            margin-bottom: 14px;
        }

        .plant-card h3 {
            font-size: 19px;
            color: var(--green-dark);
            margin-bottom: 6px;
        }

        .plant-card p {
            font-size: 14px;
            color: var(--text-gray);
            margin-bottom: 14px;
            min-height: 66px; /* 让每张卡片的描述高度尽量一致，看起来整齐 */
        }

        .plant-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .tag {
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 999px;
            background: var(--green-light);
            color: var(--green-dark);
        }

        /* ============================================================
           第 9 部分：页脚
           ============================================================ */
        footer {
            text-align: center;
            padding: 28px 6%;
            background: var(--green-dark);
            color: #d8ece1;
            font-size: 14px;
        }

        /* ============================================================
           第 10 部分：挂件模式（body 上加 widget-mode 类后生效）
           效果：只保留虚拟形象，其他全部隐藏，页面背景完全透明，
                 适合配合"透明浏览器 / 桌面挂件工具"贴在桌面上用。
           技巧：给 body 加一个类名，所有"挂件模式专属样式"都写成
                 body.widget-mode xxx 的形式，类名一加就生效、一删就还原。
           ============================================================ */

        /* 导航栏上的"挂件模式"按钮 */
        .widget-btn {
            padding: 8px 16px;
            border-radius: 999px;
            border: 2px solid var(--green-main);
            background: transparent;
            color: var(--green-dark);
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.25s, color 0.25s;
        }

        .widget-btn:hover {
            background: var(--green-main);
            color: #fff;
        }

        /* ---- 挂件模式下：隐藏所有其他内容 ----
           （display:none = 直接不显示，连位置都不占）
           注意：语音输入按钮 .mic-btn 和对话框要保留！
                 这样桌宠在桌面上还能继续和你互动 */
        body.widget-mode .navbar,
        body.widget-mode .hero-text,
        body.widget-mode #sensors,
        body.widget-mode #diagnosis,
        body.widget-mode #wiki,
        body.widget-mode footer,
        body.widget-mode .pet-hint {
            display: none;
        }

        /* ---- 挂件模式下：页面背景透明 ----
           html 和 body 都设为透明，才能真正"透出桌面" */
        body.widget-mode {
            background: transparent;
        }

        html.widget-mode {
            background: transparent;
        }

        /* 挂件模式下：桌宠舞台铺满整个窗口（人物就能被拖到任意位置） */
        body.widget-mode .hero {
            padding: 0;
            min-height: 100vh;
            display: block;
            max-width: none;
        }

        body.widget-mode .hero-avatar {
            width: 100%;
            height: 100vh;
        }

        body.widget-mode .pet-stage {
            width: 100%;
            height: 100vh;
        }

        /* 挂件模式下：人物立牌去掉边框底色，更像悬浮桌宠 */
        body.widget-mode .pet-face {
            border: none;
            background: transparent;
            box-shadow: none;
        }

        /* 挂件模式下：语音按钮缩成小圆钮，放在左下角不碍事 */
        body.widget-mode .mic-btn {
            position: fixed;
            left: 16px;
            bottom: 16px;
            margin: 0;
            padding: 12px 16px;
            opacity: 0.55;                    /* 半透明，不抢镜 */
            transition: opacity 0.25s;
        }

        body.widget-mode .mic-btn:hover {
            opacity: 1;
        }

        /* ---- 挂件模式专用的"退出"小按钮 ----
           平时藏起来，进入挂件模式后才出现（半透明，不挡视线） */
        .widget-exit-btn {
            display: none;
            position: fixed;
            top: 14px;
            right: 14px;
            z-index: 2000;
            padding: 8px 16px;
            border: none;
            border-radius: 999px;
            background: rgba(47, 107, 79, 0.55);
            color: #fff;
            font-size: 13px;
            cursor: pointer;
            transition: background-color 0.25s;
        }

        .widget-exit-btn:hover {
            background: rgba(47, 107, 79, 0.9);
        }

        /* 挂件模式下才显示退出按钮 */
        body.widget-mode .widget-exit-btn {
            display: block;
        }

        /* ============================================================
           第 11 部分：小屏适配（手机上略微缩小标题和桌宠）
           ============================================================ */
        @media (max-width: 600px) {
            .hero-text h1 { font-size: 30px; }
            .pet-stage { width: 260px; height: 330px; }
            .pet { width: 180px; height: 215px; }
            .nav-links { gap: 0; }
            .nav-links a { padding: 8px 10px; font-size: 13px; }
        }
    </style>
</head>

<body>

